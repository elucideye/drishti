string(COMPARE EQUAL "@IOS_DEPLOY_COMMAND@" "" is_empty)
if(is_empty)
  message(FATAL_ERROR "Expected IOS_DEPLOY_COMMAND")
endif()

string(COMPARE EQUAL "${APP_SOURCE}" "" is_empty)
if(is_empty)
  message(FATAL_ERROR "Expected APP_SOURCE")
endif()

# convert

# APP_SOURCE=/SomeLongPathy/MinSizeRel${EFFECTIVE_PLATFORM_NAME}/test-drishti-core.app/test-drishti-core"
# APP_DIR=/SomeLongPathy/MinSizeRel${EFFECTIVE_PLATFORM_NAME}/test-drishti-core.app/test-drishti-core"
# APP_PATH=/SomeLongPathy/MinSizeRel-iphoneos/test-drishti-core.app"

# 1) first get the *.app directory name
get_filename_component(APP_DIR "${APP_SOURCE}" DIRECTORY)
# 2) expand EFFECTIVE_PLATFORM_NAME
string(REPLACE "\${EFFECTIVE_PLATFORM_NAME}" "-iphoneos" APP_PATH "${APP_DIR}")

message("Push application to device: ${APP_SOURCE}")
message("Push application to device: ${APP_DIR}")
message("Push application to device: ${APP_PATH}")

set(cmd "@IOS_DEPLOY_COMMAND@" --justlaunch --bundle "${APP_PATH}")

execute_process(COMMAND ${cmd} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Command failed: ${cmd}")
endif()
